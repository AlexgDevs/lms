VITE_API_URL="http://127.0.0.1:8000"
# Public origin of the platform (for the Privacy Policy URL, etc.)
VITE_PUBLIC_URL="http://localhost:5173"
# WebSocket base URL (notifications). Leave unset in production to auto-derive
# from the page origin (wss://<host>); set explicitly for local dev.
VITE_WS_URL="ws://127.0.0.1:8000"