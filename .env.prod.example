# Production environment — copy to .env.prod on the server and fill in. NEVER commit.
# Used by `docker compose -f docker-compose.prod.yml --env-file .env.prod`.

# --- Public URL (frontend) ---
# The public, HTTPS origin of the site (scheme + host), e.g. https://lms.example.ru
PUBLIC_URL=https://lms.example.ru

# --- Container images (GitHub Container Registry) ---
# e.g. REGISTRY_NS=alexgdevs/lms  (lowercase GitHub owner/repo)
REGISTRY_NS=ALEXGDEVS/LMS
IMAGE_TAG=latest

# --- Backups (separate disk on the VPS) ---
BACKUP_DIR=/var/backups
BACKUP_KEEP_DAYS=14

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=change-me-strong-password
POSTGRES_DB=lms

# --- Redis ---
REDIS_USER=default
REDIS_PASSWORD=change-me-strong-redis-password

# --- MinIO (object storage, S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
STORAGE_BUCKET=lms-media
# S3 backend for the app (MinIO exposed internally via STORAGE_ENDPOINT_URL=http://minio:9000)
STORAGE_BACKEND=s3
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=change-me-minio-password
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=${PUBLIC_URL}/media
# Public media is served via nginx → MinIO (public-read bucket).

# --- App / JWT ---
API_V1_STR=/api/v1
APP_ENV=production
JWT_SECRET_KEY=change-me-64-char-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://lms.example.ru

# --- Payments (YooKassa) ---
PAYMENT_PROVIDER_MODE=yookassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
PAYMENTS_SANDBOX=false
PAYMENT_PLATFORM_FEE_PERCENT=0
PAYMENT_WEBHOOK_DEV_ACCEPT=false
# Comma-separated IPs of your reverse proxy / load balancer
YOOKASSA_TRUSTED_PROXY_IPS=127.0.0.1

# --- AI ---
AI_API_KEY=your-ai-key
AI_BASE_URL=https://openai.api.proxyapi.ru/v1
AI_MODEL=openai/gpt-4o

# --- Mail (Yandex 360 / Mail.ru) ---
MAIL_ENABLED=true
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=your@yandex-domain.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@yandex-domain.ru
SMTP_FROM_NAME=LMS
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0

# --- Code execution (Piston) ---
CODEEXEC_BASE_URL=http://piston:2000
CODEEXEC_MAX_CALLS_PER_USER_PER_MINUTE=5

# --- Frontend build-time (used by CI for the SPA) ---
# VITE_API_URL is baked into the frontend build. It must be the ORIGIN (no /api/v1):
# the generated client appends /api/v1 itself, and notifications use /notifications.
VITE_API_URL=https://lms.example.ru

# --- Founder program (optional) ---
FOUNDER_PROGRAM_ENABLED=true
FOUNDER_PROGRAM_REVENUE_LIMIT=50000
FOUNDER_PROGRAM_MAX_AUTHORS=30
FOUNDER_COMMISSION_PERCENT=5
