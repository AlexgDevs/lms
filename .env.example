# Shared / infra env — loaded by docker-compose (`env_file: .env`).
# Backend-only params live in backend/.env, frontend-only in frontend/.env.
# This file is a template: copy to .env and adjust.

#postgres
POSTGRES_USER=postgres
POSTGRES_PASS=postgres
POSTGRES_DB=lms

#redis
REDIS_PASSWORD=redispassword123

#minio (docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

#storage (used by minio-init and shared with the backend S3 config)
STORAGE_BUCKET=lms-media
