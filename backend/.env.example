#postgres
POSTGRES_USER="postgres"
POSTGRES_PASS=postgres
POSTGRES_DB="lms"

#app
JWT_SECRET_KEY="supersecretkey231"
REDIS_PASSWORD="redispassword123"
CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

#frontend
# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST="http://localhost:5173"

#storage
# Backend for object storage: "local" (filesystem) or "s3" (S3-compatible: AWS S3, MinIO, R2, Yandex Object Storage)
STORAGE_BACKEND="s3"
STORAGE_PUBLIC_BASE_URL=
# Local backend: root directory for stored files (relative to the backend dir or absolute)
STORAGE_ROOT_DIR="media"

# S3 backend credentials
STORAGE_BUCKET=lms-media
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

#media
# Maximum allowed upload size in megabytes
MEDIA_MAX_SIZE_MB=20
# Comma-separated list of allowed MIME types; "type/*" entries allow whole families
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif,image/svg+xml,video/mp4,video/webm,video/quicktime,audio/mpeg,audio/ogg,audio/wav,application/pdf,text/plain,text/markdown

#ai / tgp (The Golden Path pre-testing)
# AI gateway (OpenAI-compatible). Get a key at https://proxyapi.ru/. Leave empty to disable AI generation.
# Paid model: openai/gpt-4o
AI_API_KEY=
AI_BASE_URL=https://openai.api.proxyapi.ru/v1
AI_MODEL=openai/gpt-4o

# TGP AI client + retry tuning (all optional, defaults shown)
# Timeout (s) per AI request and SDK-level retries on the OpenAI client
#TGP_AI_TIMEOUT_SECONDS=60
#TGP_AI_MAX_RETRIES=2
# Celery worker retry budget for transient AI failures
#TGP_RETRY_MAX_RETRIES=8
# Fallback wait (s) when OpenRouter returns 429 without Retry-After
#TGP_RATE_LIMIT_DEFAULT_RETRY_SECONDS=30
# If OpenRouter's Retry-After exceeds this (s), give up instead of parking the task
#TGP_RATE_LIMIT_MAX_RETRY_COUNTDOWN=300
# Exponential backoff (s) for connection/timeout/5xx errors: base and cap
#TGP_NETWORK_RETRY_BACKOFF=10
#TGP_NETWORK_RETRY_BACKOFF_MAX=45

#minio (docker-compose)
# Credentials used by the MinIO container and the mc bootstrap (minio-init).
# Keep them in sync with STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin