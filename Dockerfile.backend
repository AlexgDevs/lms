# Backend image: FastAPI (uvicorn) — used as a base for the worker too.
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend

# Install project dependencies (the project itself is not built — no build-system).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen

# Alembic migrations live at the repo root.
COPY alembic.ini ./
COPY alembic ./alembic
COPY backend ./backend

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
